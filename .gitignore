.coverage
htmlcov/

# Local runtime artefacts
.playwright-mcp/
.playwright-cli/
.tmp/
output/playwright/

# Private IBKR exports/statements. Keep the directory, never track statements.
Extractos/*
!Extractos/.gitkeep

# Personal data quarantine — patterns that caught the 2026-05-14 leak
# (committed Google-Sheets dump of personal dividends with the live Flex
# token in the HTML). Files named *personal* / *mias* / spreadsheets dropped
# under docs/ never belong in the repo.
**/*[Pp]ersonal*
**/*[Mm]ias*
**/real-account*
docs/**/*.xlsx
docs/**/*.xls

# Flex token / account-id quarantine. If a real Flex token (24 digits) ever
# lands in a file by accident, pre-commit hooks should catch it; this just
# adds belt-and-braces for offline editing.
**/flex-token*.txt
**/*-credentials*

# Frontend (React + Vite)
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.local
.npm/

# Playwright e2e artifacts
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/playwright/.cache/

# Local Docker Compose overrides (per-machine port remaps etc.)
docker-compose.override.yml
docker-compose.override.yaml

# Claude Code personal allowlist (per-machine; never tracked)
.claude/settings.local.json

# Carpeta de fuentes/insumos locales (NUNCA commitear — contiene exports con secretos)
.nogit/

# Watchdog diagnostic dumps (py-spy / faulthandler on a scheduler wedge)
deploy/watchdog/dumps/*
!deploy/watchdog/dumps/.gitkeep
