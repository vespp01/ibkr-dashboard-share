# ============================================================================
# IBKR Backend - environment template
# Copy to `.env` and fill values. DO NOT commit `.env` (it is in .gitignore).
# ============================================================================

# ---- Flex Web Service ------------------------------------------------------
# Generate in: Client Portal -> Settings -> Account Settings -> Reporting
#                -> Flex Web Service
# Token is bearer-style; treat like a password. It expires on the date shown
# as the portal's "Activation Period" end (often ~1 year, NOT always 90 days);
# regenerate before then or pulls fail with HTTP 604.
IB_FLEX_TOKEN=replace_with_your_flex_token

# Activity Flex Query ID (the "Q" code shown next to the saved Flex Query).
# Configure one query named e.g. `dashboard_full_daily` containing all sections
# required by the dashboard: trades, cash transactions, open positions,
# corporate actions, NAV, dividend accruals, and performance sections.
IB_FLEX_QUERY_ID=replace_with_query_id

# Optional second query for activity-only intra-day (Trade Confirmation Flex).
IB_FLEX_QUERY_ID_TC=

# Date the token expires (YYYY-MM-DD, from the portal Activation Period). The
# daily job warns on Telegram within TOKEN_EXPIRY_WARN_DAYS of it (and once
# past). Empty disables. UPDATE THIS whenever you regenerate the token.
IB_FLEX_TOKEN_EXPIRY=
TOKEN_EXPIRY_WARN_DAYS=7

# ---- IB Gateway / TWS (live overlay, optional) ----------------------------
# Port mapping: paper=4002 (Gateway) / 7497 (TWS)
#               live =4001 (Gateway) / 7496 (TWS)
# Bind to 127.0.0.1 only - never expose ports publicly.
IBGW_HOST=127.0.0.1
IBGW_PORT=4002
IBGW_CLIENT_ID=11
IBGW_READONLY=true

# Set to "false" if you want the API to start without trying to connect to
# IB Gateway/TWS (Flex-only mode).
ENABLE_LIVE_OVERLAY=false

# Margin-risk alerts. Live values are checked every 3 minutes when the live
# overlay and Telegram are configured. The 10 % band matches IBKR's official
# warning region. The 20/30 % bands are configurable local policy.
MARGIN_ALERTS_ENABLED=true
MARGIN_ALERT_CRON=*/3 * * * *
MARGIN_CUSHION_WARNING_PCT=30
MARGIN_CUSHION_HIGH_PCT=20
MARGIN_CUSHION_CRITICAL_PCT=10

# Weekly informational review of the currency used for negative cash balances.
# It fetches current IBKR Pro rates and official ECB reference rates. It does
# not forecast FX, convert cash, or place orders. Missing/stale inputs suppress
# the notice instead of guessing.
MARGIN_FX_ENABLED=true
MARGIN_FX_CRON=0 8 * * 1
MARGIN_FX_CURRENCIES=CHF,EUR,GBP,USD,JPY
MARGIN_FX_HISTORY_DAYS=365
MARGIN_FX_MAX_ECB_AGE_DAYS=7
MARGIN_FX_MAX_SNAPSHOT_AGE_DAYS=4
MARGIN_FX_MIN_DEBT_CHF=100
MARGIN_FX_MIN_SAVING_CHF=50

# ---- Database --------------------------------------------------------------
# SQLite (default, file-based, zero ops). Docker Compose overrides this to the
# persistent named volume at /app/data/ibkr_backend.db.
DATABASE_URL=sqlite:///./ibkr_backend.db

# ---- OptimizadorFiscal (optional, read-only) -------------------------------
# Docker bind source. Point it at the host directory that contains the contract.
TAX_SCENARIOS_HOST_DIR=./data/tax-scenarios
# Path visible to the backend process. With Docker, use
# /app/tax-scenarios/<filename>. The file must implement tax_sale_scenarios.v1.
# Empty keeps the Fiscal panel disconnected.
TAX_SCENARIOS_FILE=

# Postgres (uncomment when migrating):
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/ibkr

# ---- Pipeline / scheduling -------------------------------------------------
# Cron expression evaluated in the host TZ. Default: 06:30 daily.
PIPELINE_CRON=30 6 * * *

# Account base currency (used as fallback if Flex does not provide one).
BASE_CURRENCY=CHF

# Log level for ibkr_backend.* in the server. INFO surfaces the daily digest
# + token-expiry lines in `docker logs`; WARNING quiets them.
LOG_LEVEL=INFO

# ---- Telegram notifications (optional) -------------------------------------
# Daily digest (dividends/operations/commissions) after each successful pull,
# plus the token-expiry warning above. Off unless BOTH are set. Resolve the
# chat id: message the bot, then GET /bot<token>/getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- API server ------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
BACKEND_HOST_PORT=8001
FRONTEND_HOST_PORT=5173

# Optional Docker Compose isolation. Leave defaults for normal local use. Set
# these only when running multiple clones/stacks in parallel so containers and
# volumes do not collide or reuse another clone's data.
BACKEND_CONTAINER_NAME=ibkr-backend
FRONTEND_CONTAINER_NAME=ibkr-frontend
DB_VOLUME_NAME=ibkr_dashboard_db_data
BACKEND_IMAGE=ibkr-backend:dev
FRONTEND_IMAGE=ibkr-frontend:dev

# Comma-separated list of CORS origins for the frontend. Add private VPN
# origins here if you expose the dashboard beyond localhost.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ---- Watchlist -------------------------------------------------------------
# Path to the YAML source of truth for watchlists.
WATCHLIST_FILE=./watchlists.yaml

# ---- Client Portal Gateway (CPG) - IBKR watchlist import ------------------
# Used by `python -m ibkr_backend.cli watchlist-import` to pull watchlists
# saved in TWS / Mobile / Web. Requires the CPG (clientportal.gw) to be
# running locally and a one-time browser login at https://localhost:5000.
# Sessions last 24h; idle timeout 6 min unless /tickle is called every 5 min.
CPG_BASE_URL=https://localhost:5000/v1/api
# CPG ships with a self-signed cert by default. Use "false" to skip TLS
# verification on localhost, "true" to verify, or path to a PEM bundle.
CPG_VERIFY_TLS=false
